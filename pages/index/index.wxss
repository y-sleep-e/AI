.page {
  flex: 1;
  padding: 20rpx;
  background: #f5f7fb;
}

.top {
  display: flex;
  justify-content: flex-start;
  margin-bottom: 20rpx;
}

.location {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #222;
}

.location-icon {
  margin-right: 10rpx;
}

.location-text {
  font-weight: 600;
}

.location-tip {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #999;
}

.intro {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.logo-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid #e6e6e6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #1890ff;
  margin-right: 20rpx;
}

.intro-text {
  flex: 1;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: #0a0a0a;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666;
}

.actions {
  margin-bottom: 30rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card {
  flex: 1;
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx;
  margin-right: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.card:last-child {
  margin-right: 0;
}

.card.wide {
  flex: 1;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0a0a0a;
  margin-bottom: 12rpx;
}

.card-sub {
  font-size: 22rpx;
  color: #888;
}

.recommend {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0a0a0a;
}

.teacher-scroll {
  height: 320rpx;
}

.teacher-card {
  width: 520rpx;
  background: #fff;
  border-radius: 18rpx;
  padding: 20rpx;
  margin-right: 18rpx;
  box-shadow: 0 3rpx 16rpx rgba(0, 0, 0, 0.07);
}

.teacher-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50rpx;
  background: #eee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #999;
  margin-right: 14rpx;
}

.name-row {
  flex: 1;
}

.name {
  font-size: 28rpx;
  font-weight: 700;
  color: #0a0a0a;
}

.rating {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #f5a623;
}

.school,
.subject,
.meta {
  font-size: 22rpx;
  color: #666;
  margin-top: 10rpx;
}

.labels {
  margin-top: 12rpx;
}

.label {
  display: inline-block;
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
  background: rgba(24, 120, 255, 0.09);
  color: #1772ff;
  font-size: 20rpx;
}

.bottom-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 18rpx;
}

.price {
  font-size: 28rpx;
  font-weight: 700;
  color: #1677ff;
}

.book {
  padding: 10rpx 22rpx;
  border-radius: 18rpx;
  background: #1677ff;
  color: #fff;
  font-size: 22rpx;
}
