<view class="page">
  <view class="top">
    <view class="location">
      <text class="location-icon">📍</text>
      <text class="location-text">{{locationText}}</text>
      <text class="location-tip" wx:if="{{locationTip}}">{{locationTip}}</text>
    </view>
  </view>

  <view class="intro">
    <view class="logo-placeholder">LOGO</view>
    <view class="intro-text">
      <text class="title">AI家教小程序</text>
      <text class="subtitle">智能匹配 · 学习升级</text>
    </view>
  </view>

  <view class="actions">
    <view class="row">
      <view class="card" bindtap="gotoTeacherStudent" data-type="needTeacher">
        <text class="card-title">我要做家教</text>
        <text class="card-sub">发布需求，快速匹配</text>
      </view>
      <view class="card" bindtap="gotoTeacherStudent" data-type="beTeacher">
        <text class="card-title">我要请教员</text>
        <text class="card-sub">注册认证，成为教员</text>
      </view>
    </view>
    <view class="row">
      <view class="card wide" bindtap="gotoAICenter">
        <text class="card-title">我要问AI</text>
        <text class="card-sub">学习难题一键解答，家教需求智能分析</text>
      </view>
    </view>
  </view>

  <view class="recommend">
    <view class="section-header">
      <text class="section-title">推荐教员</text>
    </view>
    <scroll-view scroll-x="true" class="teacher-scroll" show-scrollbar="false">
      <view class="teacher-card" wx:for="{{teachers}}" wx:key="id">
        <view class="teacher-head">
          <view class="avatar">头像</view>
          <view class="name-row">
            <text class="name">{{item.name}}</text>
            <text class="rating">{{item.rating}}</text>
          </view>
        </view>
        <text class="school">{{item.school}}</text>
        <text class="subject">{{item.subject}}</text>
        <text class="meta">{{item.grade}} · {{item.experience}}</text>
        <view class="labels">
          <text class="label">{{item.tag}}</text>
        </view>
        <view class="bottom-row">
          <text class="price">¥{{item.price}}/课</text>
          <button class="book" bindtap="bookTeacher" data-id="{{item.id}}">预约</button>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
