.container {
  padding-bottom: 30px;
  min-height: 100vh;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  padding: 50px 20px 30px;
  display: flex;
  align-items: center;
  gap: 16px;
  color: white;
}
.user-avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  text-align: center;
  line-height: 60px;
  font-size: 30px;
  flex-shrink: 0;
}
.user-info {
  flex: 1;
}
.username {
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 8px;
  display: block;
}
.role-switch {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  opacity: 0.9;
}
.role-switch button {
  background: rgba(255,255,255,0.2);
  color: white;
  border: none;
  font-size: 12px;
  height: 28px;
  line-height: 28px;
  border-radius: 14px;
}

/* 会员卡片 */
.vip-card {
  margin-top: -20px;
  padding: 16px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.vip-left .vip-title {
  display: block;
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 4px;
}
.vip-left .vip-desc {
  font-size: 12px;
  color: #666;
}
.vip-arrow {
  font-size: 18px;
  color: #999;
}

/* 功能菜单 */
.menu-list {
  margin-top: 20px;
}
.menu-group {
  margin: 0 16px 16px;
  border-radius: 12px;
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 16px;
  border-bottom: 1px solid #f0f0f0;
  background: white;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-icon {
  font-size: 20px;
  margin-right: 12px;
}
.menu-name {
  flex: 1;
  font-size: 15px;
}
.menu-arrow {
  font-size: 16px;
  color: #999;
}

/* 退出按钮 */
.logout-btn {
  margin: 30px 16px 0;
  background: white;
  color: #ff4d4f;
  border: 1px solid #ffccc7;
  border-radius: 8px;
}