.container {
  padding-bottom: 30px;
}

/* 头部样式 */
.header {
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  color: white;
  padding: 40px 20px 30px;
  text-align: center;
}
.location {
  font-size: 14px;
  opacity: 0.9;
  margin-bottom: 10px;
}
.title {
  font-size: 28px;
  font-weight: bold;
  margin-bottom: 8px;
}
.subtitle {
  font-size: 14px;
  opacity: 0.85;
}

/* 功能入口 */
.entrance-card {
  margin-top: -20px;
  padding: 20px 16px;
}
.entrance-row {
  display: flex;
  margin-bottom: 16px;
}
.entrance-item {
  flex: 1;
  text-align: center;
}
.entrance-full {
  text-align: center;
  padding-top: 16px;
  border-top: 1px solid #f0f0f0;
}
.entrance-icon {
  font-size: 32px;
  margin-bottom: 8px;
}
.entrance-item text, .entrance-full text {
  display: block;
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 4px;
}
.entrance-desc {
  font-size: 12px !important;
  color: #666;
  font-weight: normal !important;
}

/* 教员推荐 */
.teacher-section {
  margin-top: 20px;
}
.section-title {
  font-size: 18px;
  font-weight: bold;
  margin: 0 16px 12px;
}
.teacher-scroll {
  white-space: nowrap;
  padding: 0 16px;
}
.teacher-card {
  display: inline-block;
  width: 160px;
  background: white;
  border-radius: 12px;
  padding: 16px 12px;
  margin-right: 12px;
  text-align: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.teacher-avatar {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: #1677ff;
  color: white;
  line-height: 50px;
  font-size: 20px;
  margin: 0 auto 10px;
}
.teacher-name {
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 4px;
}
.teacher-school {
  font-size: 12px;
  color: #666;
  margin-bottom: 4px;
}
.teacher-subject {
  font-size: 13px;
  color: #1677ff;
  margin-bottom: 4px;
}
.teacher-tag {
  font-size: 11px;
  color: #999;
  margin-bottom: 8px;
}
.teacher-price {
  font-size: 16px;
  color: #ff4d4f;
  font-weight: bold;
  margin-bottom: 10px;
}
.teacher-btn {
  width: 100%;
  height: 32px;
  line-height: 32px;
  font-size: 13px;
}