.container {
  padding-bottom: 80px;
}

/* 顶部栏 */
.top-bar {
  background: white;
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 10px;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-switch {
  display: flex;
  background: #f5f7fa;
  border-radius: 6px;
  padding: 4px;
}
.tab-item {
  padding: 6px 12px;
  border-radius: 4px;
  font-size: 14px;
  transition: all 0.3s;
}
.tab-item.active {
  background: #1677ff;
  color: white;
}
.search-box {
  flex: 1;
}
.search-box input {
  background: #f5f7fa;
  border-radius: 20px;
  height: 36px;
  padding: 0 12px;
  font-size: 14px;
}
.filter-btn {
  width: 50px;
  height: 36px;
  line-height: 36px;
  padding: 0;
  font-size: 14px;
  border-radius: 6px;
}

/* 学员需求卡片 */
.parent-card {
  padding: 16px;
}
.parent-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
}
.parent-header .name {
  font-size: 16px;
  font-weight: 500;
}
.parent-header .time {
  font-size: 12px;
  color: #999;
}
.demand {
  font-size: 14px;
  color: #1677ff;
  margin-bottom: 8px;
}
.desc {
  font-size: 14px;
  color: #333;
  margin-bottom: 12px;
}
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.price {
  font-size: 16px;
  color: #ff4d4f;
  font-weight: bold;
}
.btn-group {
  display: flex;
  gap: 8px;
}
.btn-line {
  border: 1px solid #1677ff;
  color: #1677ff;
  background: white;
  border-radius: 6px;
}

/* 教员卡片 */
.teacher-card {
  padding: 16px;
  display: flex;
  gap: 12px;
}
.teacher-left {
  flex-shrink: 0;
}
.avatar {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: #1677ff;
  color: white;
  text-align: center;
  line-height: 50px;
  font-size: 20px;
}
.teacher-right {
  flex: 1;
}
.teacher-header {
  margin-bottom: 6px;
}
.teacher-header .name {
  font-size: 16px;
  font-weight: 500;
  margin-right: 8px;
}
.teacher-header .school {
  font-size: 13px;
  color: #666;
}
.tag-row {
  margin-bottom: 6px;
}
.tag {
  display: inline-block;
  background: #e8f3ff;
  color: #1677ff;
  font-size: 12px;
  padding: 2px 6px;
  border-radius: 4px;
  margin-right: 6px;
  margin-bottom: 4px;
}
.teacher-right .desc {
  font-size: 13px;
  color: #666;
  margin-bottom: 10px;
}

/* 悬浮窗 */
.float-btn {
  position: fixed;
  bottom: 80px;
  right: 20px;
  background: #1677ff;
  color: white;
  padding: 12px 20px;
  border-radius: 30px;
  box-shadow: 0 4px 12px rgba(22, 119, 255, 0.4);
  font-size: 14px;
  font-weight: 500;
  z-index: 99;
}