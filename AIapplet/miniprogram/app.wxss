/* 全局样式重置 */
page {
  background-color: #f5f7fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* 通用按钮样式 */
.btn-primary {
  background-color: #1677ff;
  color: white;
  border-radius: 8px;
  border: none;
  font-size: 16px;
  line-height: 44px;
  height: 44px;
}

.btn-primary:active {
  background-color: #0d5bdb;
}

/* 通用卡片样式 */
.card {
  background-color: white;
  border-radius: 12px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  margin: 12px 16px;
  overflow: hidden;
}

/* flex通用布局 */
.flex-row {
  display: flex;
  flex-direction: row;
}
.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}